# Kopiere diese Datei zu ".env.local" und trage deine Werte aus Supabase ein
# (Supabase → Project Settings → API). Die Datei .env.local wird NICHT ins Repo hochgeladen.
# Ohne diese Werte startet das Spiel im lokalen Testmodus (nur Tabs im selben Browser).
VITE_SUPABASE_URL=https://deinprojekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
