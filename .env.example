# Kopiere diese Datei zu ".env.local" und trage deine Werte aus Supabase ein
# (Supabase → Connect oder Project Settings → API Keys). .env.local wird NICHT ins Repo hochgeladen.
# Ohne diese Werte startet das Spiel im lokalen Testmodus (nur Tabs im selben Browser).
VITE_SUPABASE_URL=https://deinprojekt.supabase.co
# Der öffentliche Schlüssel (beginnt mit sb_publishable_…). Statt dieses Namens geht auch
# der ältere Name VITE_SUPABASE_ANON_KEY. NIEMALS den secret-/service_role-Schlüssel eintragen!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Optional, empfohlen: eigener Raum-Server auf Cloudflare (keine Obergrenze an Klassen) ──
# Adresse aus dem Cloudflare-Deploy (siehe README, Abschnitt 2b). Ist sie gesetzt, läuft die
# Echtzeit über Cloudflare; Supabase wird dann nur noch für die Schulrangliste genutzt.
# VITE_CLOUDFLARE_URL=https://krippe-raum.deinname.workers.dev
# Rückfall-Schalter: auf "supabase" setzen, um trotz Cloudflare-Adresse Supabase zu benutzen.
# VITE_ECHTZEIT=supabase
